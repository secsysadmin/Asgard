# Neon/Postgres connection string. Keep this secret out of source control.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/careerfair?sslmode=require

# Local and preview development write to the development schema.
APP_ENV=development

# Set APP_ENV=production in Vercel Production environment variables.
# Vercel preview deployments automatically use the development schema.

# Required on every deployment: the password for /admin (the Site Studio).
# Without it, deployed studios refuse all sign-ins. Local dev without it is open.
ADMIN_PASSWORD=choose-a-long-passphrase

# Optional: separate secret for signing studio sessions (defaults to one
# derived from ADMIN_PASSWORD). Changing either signs everyone out.
# ADMIN_SESSION_SECRET=
